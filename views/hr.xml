<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit hr.attendance form view -->
    <record id="view_attendance_form_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert">
                    <strong>Warning:</strong> This attendance is currently open (no check-out).
                    Employee cannot have multiple open attendances on the same date.
                </div>
            </xpath>
        </field>
    </record>


    <record id="view_attendance_tree_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-info">check_out == False</attribute>
            </xpath>
        </field>
    </record>

    <!-- Optional: Add a search filter for open attendances -->
    <record id="view_attendance_search_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.search.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Open Attendances"
                        name="open_attendances"
                        domain="[('check_out', '=', False)]"/>
                <separator/>
                <filter string="Today"
                        name="today"
                        domain="[('check_in', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('check_in', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
            </xpath>
        </field>
    </record>

    <!-- Menu: Open Attendances -->
    <record id="action_hr_attendance_open" model="ir.actions.act_window">
        <field name="name">Open Attendances</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('check_out', '=', False)]</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No open attendances found
            </p>
            <p>
                This view shows all employees who have checked in but not yet checked out.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_attendance_open"
              name="Open Attendances"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_hr_attendance_open"
              sequence="15"/>

    <!-- Menu: Today's Attendances -->
    <record id="action_hr_attendance_today" model="ir.actions.act_window">
        <field name="name">Today's Attendances</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendances recorded today
            </p>
            <p>
                Track all check-ins and check-outs for today.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_attendance_today"
              name="Today's Attendances"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_hr_attendance_today"
              sequence="10"/>

</odoo>